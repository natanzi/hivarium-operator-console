{
  "name": "hivarium-operator-console",
  "main": "worker/src/index.ts",
  "compatibility_date": "2024-05-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  // D1 durable store owned by the Worker API (D-01). The database_id below is
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hivarium-operator-console",
      "database_id": "7bda4b7e-da65-43b8-bae9-1cc965b63c22"
    }
  ],
  "services": [
    {
      "binding": "LICENSE_SERVICE",
      "service": "hivarium-license-service"
    },
    {
      "binding": "CUSTOMER_PORTAL_SERVICE",
      "service": "hivarium-customer-portal"
    }
  ],
  // Cloudflare Access JWT verification configuration (D-03). These are
  // non-secret configuration values; override them per environment before
  // deploying. The Access application AUD and team domain are public values
  // carried inside the JWT itself.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "damp-thunder-3785.cloudflareaccess.com",
    "ACCESS_AUD": "e1b8f94ab08c140439a7d0bd57c0397b4a51caf21d646e6fc04059653c928f1a",
    "AUTHORIZED_OPERATOR_EMAIL": "miladnatanzi@gmail.com"
  },
  // Resolve the SPA's "@/*" import alias inside the Worker bundle so the
  // shared domain rules and deterministic seed can be imported by relative
  // paths from worker/ (D-07, D-11).
  "alias": {
    "@": "./src"
  }
}